{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The main window may call exactly the IPC commands of spec §5.7 (with preview_render, open_external, advanced_read, recovery_status, theme_pause, theme_resume, app_ready, app_status, crash_dismiss, crash_report_read, settings_reset, log_ui_error, app_restart, update_status and update_install) and listen for the apply-progress event. Nothing else: no plugin command, no shell, no file system (spec §5.10).",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-system-detect",
    "allow-themes-list",
    "allow-theme-get",
    "allow-theme-save",
    "allow-theme-duplicate",
    "allow-theme-delete",
    "allow-theme-import-preview",
    "allow-theme-import-confirm",
    "allow-theme-export",
    "allow-palette-generate",
    "allow-contrast-check",
    "allow-contrast-fix",
    "allow-preview-render",
    "allow-plan-apply",
    "allow-apply",
    "allow-undo-last",
    "allow-snapshots-list",
    "allow-snapshot-restore",
    "allow-revert-all",
    "allow-doctor-run",
    "allow-doctor-fix",
    "allow-settings-get",
    "allow-settings-set",
    "allow-open-cmd",
    "allow-open-external",
    "allow-diagnostics-copy",
    "allow-advanced-read",
    "allow-recovery-status",
    "allow-theme-pause",
    "allow-theme-resume",
    "allow-app-ready",
    "allow-app-status",
    "allow-crash-dismiss",
    "allow-crash-report-read",
    "allow-settings-reset",
    "allow-log-ui-error",
    "allow-app-restart",
    "allow-update-status",
    "allow-update-install"
  ]
}
