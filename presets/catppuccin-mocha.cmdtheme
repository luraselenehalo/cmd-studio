  "tone": "dark",
  "simple": null,
  "colors": {
    "background": "#1e1e2e",
    "foreground": "#cdd6f4",
    "cursor": "#f5e0dc",
    "selection": "#585b70",
    "accent": "#cba6f7",
    "muted": "#9399b2",
    "frame": "#6c7086",
    "ansi": [
      "#45475a", "#f38ba8", "#a6e3a1", "#f9e2af", "#89b4fa", "#f5c2e7", "#94e2d5", "#bac2de",
