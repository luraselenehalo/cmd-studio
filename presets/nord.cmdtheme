  "name": "Nord",
  "author": "CMD Studio",
  "tone": "dark",
  "simple": null,
  "colors": {
    "background": "#2e3440",
    "foreground": "#d8dee9",
    "cursor": "#d8dee9",
    "selection": "#4c566a",
    "accent": "#88c0d0",
    "muted": "#a5abb6",
    "frame": "#3b4252",
    "ansi": [
      "#3b4252", "#bf616a", "#a3be8c", "#ebcb8b", "#81a1c1", "#b48ead", "#88c0d0", "#e5e9f0",
      "#4c566a", "#bf616a", "#a3be8c", "#ebcb8b", "#81a1c1", "#b48ead", "#8fbcbb", "#eceff4"
