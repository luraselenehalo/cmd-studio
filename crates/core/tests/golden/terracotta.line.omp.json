{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "blocks": [
    {
      "alignment": "left",
      "segments": [
        {
          "foreground": "p:blue",
          "options": {
            "home_icon": "~",
            "style": "full"
          },
          "style": "plain",
          "template": "{{ .Path }} ",
          "type": "path"
        },
        {
          "foreground": "p:ok",
          "foreground_templates": [
            "{{ if or .Working.Changed .Staging.Changed }}p:dirty{{ end }}"
          ],
          "options": {
            "branch_icon": "",
            "cherry_pick_icon": "pick ",
            "commit_icon": "@",
            "fetch_status": true,
            "merge_icon": "merge ",
            "no_commits_icon": "",
            "rebase_icon": "rebase ",
            "revert_icon": "revert ",
            "tag_icon": "#"
          },
          "style": "plain",
          "template": "{{ .HEAD }}{{ if or .Working.Changed .Staging.Changed }} *{{ else }} ✓{{ end }} ",
          "type": "git"
        },
        {
          "foreground": "p:muted",
          "options": {
            "time_format": "15:04"
          },
          "style": "plain",
          "template": "{{ .CurrentDate | date .Format }} ",
          "type": "time"
        },
        {
          "foreground": "p:accent",
          "style": "plain",
          "template": "❯",
          "type": "text"
        }
      ],
      "type": "prompt"
    }
  ],
  "console_title_template": "{{ .Folder }}",
  "final_space": true,
  "palette": {
    "accent": "#d97757",
    "bg": "#1f1e1d",
    "blue": "#7fa7d9",
    "dirty": "#e3b66b",
    "fg": "#faf9f5",
    "frame": "#5f5d58",
    "muted": "#8a8780",
    "ok": "#8fbf7f",
    "red": "#e5736a"
  },
  "transient_prompt": {
    "background": "transparent",
    "foreground": "p:accent",
    "template": "> "
  },
  "version": 4
}
